# ========================
# ML Diagnose Environment Variables
# ========================
# Copy this file to .env and fill in your values
# Do NOT commit .env to version control!

# Server Configuration
# HOST=0.0.0.0
# PORT=8000
# DEBUG=false

# CORS — comma-separated list of allowed frontend origins
# In production, set this to your deployed frontend URL(s).
# Defaults to localhost:3000/3001 if not set.
# CORS_ORIGINS=https://your-frontend.com,https://www.your-frontend.com

# Frontend API Base URL (set in frontend/.../web/.env)
# NEXT_PUBLIC_API_URL=https://your-backend-api.com

# Upload Configuration
# MAX_UPLOAD_SIZE_MB=50
# ALLOWED_EXTENSIONS=csv,xlsx,parquet

# Future: Database Configuration (if needed)
# DATABASE_URL=sqlite:///./app.db

# Future: API Keys (if needed)
# OPENAI_API_KEY=your_api_key_here
