{
  "name": "frontend",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm -w apps/web run dev",
    "build": "npm -w apps/web run build",
    "start": "npm -w apps/web run start",
    "check-types": "npm -w apps/web run check-types",
    "dev:web": "npm -w apps/web run dev"
  },
  "dependencies": {
    "@frontend/env": "*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.2",
    "lucide-react": "^0.563.0",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@frontend/config": "*",
    "typescript": "^5"
  },
  "packageManager": "npm@11.6.0"
}
